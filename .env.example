APP_ENV=dev                          # local | dev | test | staging | prod
HTTP_PORT=8080
METRICS_PORT=9090

OTEL_SERVICE_NAME=workflow-stream-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=none     # collector address, or none to disable export
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0

VALKEY_ADDR=localhost:6380
VALKEY_PASSWORD=
VALKEY_DIAL_TIMEOUT=2s
VALKEY_READ_TIMEOUT=1s
VALKEY_WRITE_TIMEOUT=1s

# Guards POST /api/v1/internal/events; required outside dev and local.
WORKFLOW_STREAM_GATEWAY_TOKEN=dev-token

TICKET_TTL=60s
TICKET_MINT_RATE_MAX=10
TICKET_MINT_RATE_WINDOW=60s
STREAM_RETENTION_WINDOW=10m
STREAM_KEY_TTL=15m
CONNECTION_CAP_PER_USER=5
HEARTBEAT_INTERVAL=15s
